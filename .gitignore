# DSBoard2026 — ignore generated, local, and CAD cache files.
# Track source: docs, CAD projects, firmware, software, manufacturing releases.

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
.history/

# --- Python (tools/ + future software/) ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Arduino / firmware ---
*.elf
*.hex
*.bin
*.eep
*.map
.pio/
.vscode/.browse.c_cpp.db*
compile_commands.json

# --- Generated docs ---
_pdf_preview.html
docs/generated/_pdf_preview.html
# Uncomment if you do not want generated PDFs in git:
# docs/generated/*.pdf

# --- KiCad (when hardware/ holds a .kicad_pro) ---
# Do not use a global *.xml / *.csv — that would hide Draw.io sources and BOMs.
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups/
_autosave-*
\#auto_saved_files\#
fp-info-cache
~*.lck
*.kicad_prl
*.net
*.dsn
*.ses
hardware/**/*-backups/
hardware/**/.history/

# --- Altium Designer (when hardware/ holds a .PrjPcb) ---
History/
__Previews/
Project Logs*/
Project Outputs*/
*.PrjPcbStructure
*.PrjPCBStructure
*.SchDocPreview
*.PcbDocPreview
*.PcbDoc.htm
.~lock.*
debug.log
Status Report.txt

# --- Generic EDA / CAM scratch ---
*.zip.bak
*.tmp
*.log
*.lck

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.key
credentials.json
